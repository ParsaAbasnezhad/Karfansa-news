# Copy to .env.production and replace every REPLACE_ value before deployment.
# This file is for the host TLS reverse proxy + loopback Compose topology in
# docs/deployment.md. Keep the real file private and outside version control.
PROXY_PORT=8080

POSTGRES_DB=karfansa_news
POSTGRES_USER=karfansa_news
# URL-safe because Compose embeds this in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
# URL-safe because Compose embeds this in Redis URLs.
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD

DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_DJANGO_SECRET
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_PUBLIC_HOSTNAME
DJANGO_CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_PUBLIC_HOSTNAME
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_LANGUAGE_CODE=fa
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# Only enable after the trusted host proxy overwrites forwarding headers and
# the backend remains inaccessible from public networks.
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_TRUST_X_REAL_IP=true
DJANGO_SECURE_SSL_REDIRECT=true

# Start with HSTS disabled. Raise only after HTTPS is verified for the chosen
# host; includeSubDomains and preload require a separate domain-wide audit.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Configure a working provider before enabling password recovery in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=REPLACE_WITH_SMTP_HOST
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=REPLACE_WITH_SMTP_USER
DJANGO_EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER_ADDRESS

# The current frontend exposes SMS account flows. Configure a working provider
# and provider-specific secrets before exposing those flows in production.
SMS_PROVIDER_CLASS=
KAVENEGAR_API_KEY=
KAVENEGAR_VERIFY_TEMPLATE=
KAVENEGAR_SENDER=
AUTH_PUBLIC_RESPONSE_FLOOR_SECONDS=0.75
