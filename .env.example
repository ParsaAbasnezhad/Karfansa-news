# =============================================================================
# Karfansa News — environment variables
# Copy to `.env` and adjust. NEVER commit `.env` or real secrets.
# =============================================================================

# --- Docker Compose ----------------------------------------------------------
# Host ports (chosen to avoid clashing with other local projects).
FRONTEND_PORT=5174
BACKEND_PORT=8010

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=karfansa_news
POSTGRES_USER=karfansa_news
# Placeholder only. Generate a strong value. Use URL-safe characters
# (letters, digits, "-", "_") because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-db-password

# --- Django ------------------------------------------------------------------
# Selects config/settings/<name>.py
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174
DJANGO_LANGUAGE_CODE=en
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
SEO_SITE_URL=https://karfansa.news.ir
SEO_GOOGLE_VERIFICATION=
SEO_VERIFIED_SOCIAL_URLS=

# --- Authentication notifications -------------------------------------------
# Development SMS codes appear in backend/celery_worker logs. In production
# use a configured SMS provider; console mode is rejected when DEBUG=False.
SMS_BACKEND=console
# Development email uses Django's console backend. Production requires SMTP
# and a real sender address. Keep credentials in the deployment environment.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=Karfansa <no-reply@localhost>

# Optional email preview for developers who do not want SMS codes in logs.
SMS_PROVIDER_CLASS=
SMS_DEV_INBOX=
# Kavenegar VerifyLookup (official docs: /v1/{API-KEY}/verify/lookup.json).
# Set SMS_PROVIDER_CLASS=apps.users.providers.kavenegar.KavenegarSmsProvider
# after the template is approved in the Kavenegar panel. Never commit the key.
KAVENEGAR_API_KEY=
KAVENEGAR_VERIFY_TEMPLATE=
KAVENEGAR_SENDER=
AUTH_PUBLIC_RESPONSE_FLOOR_SECONDS=0.75

# --- Redis / Celery ----------------------------------------------------------
# Inside Docker the hostnames are the compose service names.
REDIS_URL=redis://redis:6379/0

# --- Frontend (build-time, exposed to the browser: never put secrets here) ---
VITE_API_URL=/api/v1
VITE_PROXY_TARGET=http://backend:8000
